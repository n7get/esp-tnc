CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_AX25_WIFI_STA_HOSTNAME_DEFAULT="esp-tnc"
CONFIG_AX25_AGWPE_SERVER_TASK_STACK_SIZE=4096
CONFIG_AX25_ROUTER_PORT_TASK_STACK_SIZE=6144
CONFIG_AX25_PHY_TCP_SERVER_ACCEPT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_ABORT_WHEN_ALLOCATION_FAILS=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Trim Wi-Fi RAM use conservatively before touching interoperability-sensitive
# features like AMPDU or WPA2 crypto support.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# Keep Wi-Fi auth limited to WPA2-Personal/PSK features.
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_H2E is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_WAPI_PSK is not set
# CONFIG_ESP_WIFI_SUITE_B_192 is not set
# CONFIG_ESP_WIFI_DPP_SUPPORT is not set

#
# Addational logging
#
CONFIG_AX25_ROUTER_LOG_FRAMES=y
CONFIG_AX25_ROUTER_LOG_PORT_STATUS=y
CONFIG_AX25_CONN_LOG_FRAMES=y
CONFIG_AX25_CONN_LOG_DROPPED_FRAMES=y
CONFIG_AX25_PHY_UART_LOG_FRAMES=y
